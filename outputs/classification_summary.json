  "taxonomy_notes": {
    "RCE": "Requires public confirmation of compromise or demonstrated control-flow/code execution.",
    "Write Primitive": "Attacker-influenced input causes a write-capable memory effect. Absolute address/value control is not required: a deterministic single-byte or null-byte overwrite qualifies even when the immediate observed outcome is an assertion or baseband crash. This class does not assert code execution.",
    "DoS": "Explicit read/crash memory-safety class or low-information CVE without public write-capable corruption.",
    "Low information CVE": "No read/write/lifetime primitive is public. This family includes both records with only generic memory-corruption wording and records retained under the low-information policy. Impact remains independent: an otherwise confirmed RCE stays RCE; other unknown-primitive cases receive conservative DoS.",
    "evidence_bands": {
      "advisory-only": "A vendor or CVE record states the weakness or potential outcome, without deeper public technical analysis.",
      "technical-characterization": "Public evidence reproduces the failure, identifies a detailed root cause, or characterizes an attacker-relevant memory primitive.",
      "exploitation-evidence": "Public evidence demonstrates control-flow redirection or explicitly confirms arbitrary code execution under stated attack conditions."
    },
    "evidence_independence": "Evidence depth measures information completeness, not impact or criticality.",
    "scope": "Primary attack surface is separate from multi-valued RAT and protocol annotations; Multi-RAT is not a catch-all scope.",
    "scope_comparison": "Counts measure disclosures in this corpus, not per-device or per-line-of-code vulnerability rates.",
    "missing_memory_evidence": "If a record is not explicitly non-memory and no public memory-safety root cause exists, retain it in the Low information CVE family. Use conservative DoS unless independent public evidence confirms RCE."
  }
}
